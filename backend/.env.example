# ---- Сервер ----
PORT=3000
JWT_SECRET=change-me-in-production
COMMISSION_PERCENT=10

# ---- База даних ----
# Якщо DATABASE_URL порожній — використовується вбудована SQLite (sql.js) у файлі data/staybook.sqlite
# DATABASE_URL=postgres://staybook:staybook@localhost:5432/staybook

# ---- Redis (кеш пошуку + блокування номера на час оплати) ----
# Якщо порожній — використовується кеш у пам'яті процесу
# REDIS_URL=redis://localhost:6379

# ---- Stripe (тестові ключі з https://dashboard.stripe.com/test/apikeys) ----
# Якщо порожні — працює тестова імітація платіжної системи
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Google Maps ----
# Якщо порожній — карта показується через OpenStreetMap (Leaflet)
# GOOGLE_MAPS_API_KEY=

# ---- SMTP (Nodemailer) ----
# Якщо SMTP_HOST порожній — листи пишуться в консоль і в таблицю сповіщень
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="StayBook <no-reply@staybook.local>"
